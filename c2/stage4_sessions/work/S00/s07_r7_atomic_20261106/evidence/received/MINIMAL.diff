+    return dict(inner_package_sha256=sha(root/ARCHIVE),inner_manifest_sha256=sha(root/'SOURCE_MANIFEST.json'),observer_sha256=delivery['candidate/stack_observer.py'],reader_sha256=delivery['candidate/run_checks.py'],cpu_contract_sha256=delivery['candidate/cpu36_contract.py'],atomic_tests_sha256=delivery['tests/test_atomic_reports.py'],interface_ready_sha256=sha(root/'S07_INTERFACE_READY.json'),comm_probe_sha256=delivery['candidate/comm_probe.py'],observation_contract_sha256=sha(root/'OBSERVATION_CONTRACT.md'),deployment_package_sha256=sha(root/DEPLOYMENT),deployment_source_manifest_sha256=sha(root/'ARTIFACT_SHA256.json'),task_card_sha256=sha(root/'TASK_CARD.md'))
+def validate(review,bindings):
+    if review.get('decision')!='PASS_FOR_S07_R7_ATOMIC' or review.get('review_complete') is not True:raise ValueError('explicit complete R7 diagnostic review required')
+    if any(review.get('bindings',{}).get(k)!=bindings[k] for k in BINDING_KEYS):raise ValueError('R7 exact SHA bindings mismatch')
+    if any(review.get('resources',{}).get(k)!=v for k,v in RESOURCES.items()):raise ValueError('R7 total resource/budget mismatch')
