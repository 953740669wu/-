+    return ['dsub','-J','-q','q_hpcai','-x','job','-R','cpu=38,mem=24576MB','-RL','mem=24576MB',
+      '-a','numa[count=1,distribution=pack]','-T','900','--env','none','--cwd',str(root),
+      '-oo',str(root/'job.log'),'bash',str(root/'run_job.sh'),review_sha]
