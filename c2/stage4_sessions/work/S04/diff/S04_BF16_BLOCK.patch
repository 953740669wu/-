+class BF16EncoderBlock(nn.TransformerEncoderLayer):
+    """One original encoder block; explicit bf16 boundary, fp32 stable islands."""
+    def __init__(self, backend):
+        super().__init__(512, 8, 2048, 0.0, batch_first=True, norm_first=True)
+        if backend not in ('torch_reference', 'kml'):
+            raise ValueError('explicit backend required')
+        self.backend = backend
+
+    def _attention(self, qkv):
+        # Keep the original SDPA kernel, fp32 score/softmax/backward path.
+        B, M, _ = qkv.shape
+        q, k, v = (t.view(B, M, 8, 64).transpose(1, 2) for t in qkv.chunk(3, -1))
+        return F.scaled_dot_product_attention(q, k, v, dropout_p=0.0).transpose(
+            1, 2).contiguous().view(B, M, 512)
+
+    def forward(self, src, src_mask=None, src_key_padding_mask=None, is_causal=False):
+        if (src.dtype != torch.bfloat16 or src.device.type != 'cpu' or src.ndim != 3
+                or src.shape[-1] != 512 or not src.is_contiguous()
+                or src_mask is not None or src_key_padding_mask is not None or is_causal):
+            raise ValueError('contiguous CPU bf16 [B,M,512], no masks/causal required')
+        from kml_ops import chain_bf16_linear
+        linear = lambda x, w, b: chain_bf16_linear(x, w, b, self.backend)
+        residual = src.float()
+        n = self.norm1(residual).bfloat16()
+        qkv = linear(n, self.self_attn.in_proj_weight, self.self_attn.in_proj_bias)
+        a = self._attention(qkv.float()).bfloat16()
+        a = linear(a, self.self_attn.out_proj.weight, self.self_attn.out_proj.bias)
+        residual = residual + a.float()
+        f = self.norm2(residual).bfloat16()
+        f = self.activation(linear(f, self.linear1.weight, self.linear1.bias))
+        f = linear(f, self.linear2.weight, self.linear2.bias)
+        return (residual + f.float()).bfloat16()
+
+
